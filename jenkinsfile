pipeline {
    agent any

    stages {

        stage('Checkout') {
            steps {
                checkout scm
            }
        }

        stage('Docker Build') {
            steps {
                bat 'docker build -t card-management-web:%BUILD_NUMBER% .'
            }
        }

        stage('Docker Test') {
            steps {
                bat 'docker images card-management-web'
            }
        }
    }
}